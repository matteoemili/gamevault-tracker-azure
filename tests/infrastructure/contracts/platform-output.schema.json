{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gamevault-tracker.local/schemas/platform-output.schema.json",
  "title": "Platform Lifecycle CLI Output",
  "description": "Non-secret result envelope emitted by scripts/platform.sh for validate, what-if, deploy, outputs, and status. Exactly one such document is written to stdout per invocation (see contracts/platform-cli.md).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "action", "status", "operationId", "platform", "diagnostics"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "action": {
      "type": "string",
      "enum": ["validate", "what-if", "deploy", "outputs", "status"]
    },
    "status": {
      "type": "string",
      "enum": ["Succeeded", "NoChange", "Degraded", "Failed"]
    },
    "operationId": {
      "type": "string",
      "minLength": 1,
      "description": "Format: <action>-<environment>-<UTC timestamp>, e.g. platform-prod-20260721T120000Z"
    },
    "platform": {
      "description": "Null only when status is Failed and no platform state could be determined",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "resourceGroupName",
            "frontDoorProfileId",
            "frontDoorId",
            "endpointCapacity",
            "registeredEndpointCount",
            "wafMode"
          ],
          "properties": {
            "resourceGroupName": { "type": "string", "minLength": 1 },
            "frontDoorProfileId": { "type": "string", "minLength": 1 },
            "frontDoorId": { "type": "string", "minLength": 1 },
            "endpointCapacity": { "type": "integer", "minimum": 1, "maximum": 25 },
            "registeredEndpointCount": { "type": "integer", "minimum": 0, "maximum": 25 },
            "wafMode": { "type": "string", "enum": ["Detection", "Prevention"] }
          }
        }
      ]
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "message": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
